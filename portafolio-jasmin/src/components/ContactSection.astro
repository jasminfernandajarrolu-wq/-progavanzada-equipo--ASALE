---
import { personalInfo } from '../data/personalInfo';
---

<section id="contacto" class="py-16 md:py-24 border-t border-slate-800/80 max-w-6xl mx-auto px-4 sm:px-6">
  <div class="relative rounded-3xl bg-gradient-to-b from-[#10192e] via-[#0d1424] to-[#090d16] border border-blue-500/20 p-8 sm:p-12 shadow-2xl overflow-hidden">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute -top-24 -right-24 w-80 h-80 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-500/10 border border-emerald-500/20 text-emerald-400">
        <span>💬 Contacto Directo & Redes</span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-white">
        ¿Tienes una propuesta, vacante o proyecto en mente?
      </h2>

      <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
        Estoy disponible para oportunidades laborales, prácticas profesionales de <strong>Ingeniería de Sistemas</strong> y proyectos de <strong>desarrollo web frontend</strong>. ¡Contáctame directamente por cualquiera de estos medios!
      </p>

      <!-- Main Contact Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 text-left">
        <!-- Phone & WhatsApp Card -->
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-emerald-500/30 space-y-3">
          <div class="flex items-center justify-between">
            <span class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center text-lg">
              📱
            </span>
            <span class="text-[11px] font-mono text-emerald-400 font-semibold px-2 py-0.5 rounded bg-emerald-500/10">
              Respuesta Rápida
            </span>
          </div>
          <div>
            <p class="text-xs text-slate-400 font-mono">Teléfono / WhatsApp:</p>
            <p class="text-lg font-bold text-white font-mono">{personalInfo.phone.display}</p>
          </div>
          <div class="flex items-center gap-2 pt-1">
            <a
              href={personalInfo.phone.whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold shadow-sm transition-all flex-1 justify-center"
            >
              <span>Abrir WhatsApp</span>
            </a>
            <a
              href={`tel:${personalInfo.phone.raw}`}
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold border border-slate-700 transition-colors"
              title="Llamar"
            >
              <span>📞 Llamar</span>
            </a>
          </div>
        </div>

        <!-- Email Card -->
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-blue-500/30 space-y-3">
          <div class="flex items-center justify-between">
            <span class="w-9 h-9 rounded-xl bg-blue-500/10 border border-blue-500/20 text-blue-400 flex items-center justify-center text-lg">
              ✉️
            </span>
            <span class="text-[11px] font-mono text-blue-400 font-semibold px-2 py-0.5 rounded bg-blue-500/10">
              Correo Electrónico
            </span>
          </div>
          <div>
            <p class="text-xs text-slate-400 font-mono">Email Profesional:</p>
            <p class="text-sm font-semibold text-white truncate" title={personalInfo.email}>
              {personalInfo.email}
            </p>
          </div>
          <div class="flex items-center gap-2 pt-1">
            <a
              href={`mailto:${personalInfo.email}`}
              class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold shadow-sm transition-all flex-1 justify-center"
            >
              <span>Enviar Correo</span>
            </a>
            <button
              id="copy-email-btn"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-semibold border border-slate-700 transition-colors"
              data-email={personalInfo.email}
              title="Copiar correo"
            >
              <span id="copy-text">Copiar</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Social Networks Links Grid -->
      <div class="pt-6 border-t border-slate-800 space-y-3">
        <p class="text-xs font-mono uppercase text-slate-400 font-semibold tracking-wider">
          Perfiles Profesionales y Redes Sociales:
        </p>

        <div class="flex flex-wrap justify-center items-center gap-3">
          {personalInfo.socials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900/90 border border-slate-800 hover:border-blue-500/40 hover:bg-slate-800/80 text-slate-300 hover:text-white text-xs font-semibold transition-all group"
            >
              <span class="text-blue-400 group-hover:scale-110 transition-transform">
                {social.name === 'GitHub' ? '🐙' : social.name === 'LinkedIn' ? '💼' : social.name === 'WhatsApp' ? '💬' : '📧'}
              </span>
              <span>{social.name}</span>
              <span class="text-slate-500 text-[10px] font-mono group-hover:text-slate-400">({social.username})</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email');
      if (email) {
        try {
          await navigator.clipboard.writeText(email);
          copyText.textContent = '¡Copiado!';
          setTimeout(() => {
            copyText.textContent = 'Copiar';
          }, 2500);
        } catch (err) {
          console.error('Error al copiar correo:', err);
        }
      }
    });
  }
</script>
