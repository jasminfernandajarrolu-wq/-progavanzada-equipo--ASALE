---
import { personalInfo } from '../data/personalInfo';

const navItems = [
  { label: 'Sobre mí', href: '#sobre-mi' },
  { label: 'Proyectos de Materias', href: '#materias' },
  { label: 'Proyectos Personales', href: '#personales' },
  { label: 'Habilidades', href: '#habilidades' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-[#090d16]/85 border-b border-slate-800/60 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a href="#sobre-mi" class="group flex items-center gap-2 font-mono text-base sm:text-lg font-bold tracking-tight">
      <span class="w-8 h-8 rounded-lg bg-gradient-to-tr from-blue-600 to-cyan-400 flex items-center justify-center text-white text-xs font-mono font-bold shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
        &lt;/&gt;
      </span>
      <span class="text-white group-hover:text-blue-400 transition-colors hidden xl:inline text-sm font-semibold">
        {personalInfo.name}
      </span>
      <span class="text-white group-hover:text-blue-400 transition-colors xl:hidden text-sm font-semibold">
        {personalInfo.shortName}
      </span>
      <span class="text-blue-400 text-xs hidden sm:inline-block font-sans font-medium px-2 py-0.5 rounded-full bg-blue-500/10 border border-blue-500/20">
        Ing. Sistemas
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-1.5 rounded-lg text-sm font-medium text-slate-300 hover:text-white hover:bg-slate-800/60 transition-all duration-150"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <!-- Quick Action / Contact -->
    <div class="hidden sm:flex items-center gap-3">
      <a
        href={personalInfo.phone.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/25 text-xs font-semibold tracking-wide transition-all shadow-sm"
        title="Enviar mensaje directo por WhatsApp"
      >
        <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.181-.076.355.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
        </svg>
        WhatsApp
      </a>

      <a
        href="#contacto"
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold tracking-wide transition-all shadow-sm shadow-blue-500/20"
      >
        Hablemos
      </a>
    </div>

    <!-- Mobile menu hamburger button -->
    <div class="flex md:hidden items-center gap-2">
      <a
        href={personalInfo.phone.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="p-2 rounded-lg bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs"
        aria-label="WhatsApp"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.007c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.181-.076.355.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
        </svg>
      </a>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        class="p-2 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/60 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <svg id="icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-800 bg-[#0c1220]/95 backdrop-blur-xl px-4 pt-3 pb-5 space-y-2">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-medium text-slate-200 hover:text-white hover:bg-slate-800/80 transition-colors"
      >
        {item.label}
      </a>
    ))}
    <div class="pt-3 border-t border-slate-800/80 flex flex-col gap-2">
      <a
        href={personalInfo.phone.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-2.5 rounded-lg bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-sm font-semibold"
      >
        <span>Escribir por WhatsApp ({personalInfo.phone.display})</span>
      </a>
      <a
        href="#contacto"
        class="mobile-nav-link flex items-center justify-center w-full py-2.5 rounded-lg bg-blue-600 text-white text-sm font-semibold"
      >
        Contactar directamente
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
