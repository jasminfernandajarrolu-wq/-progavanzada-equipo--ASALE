---
import { personalInfo } from '../data/personalInfo';

const categories = ['Frontend', 'Backend & Datos', 'Herramientas', 'Conceptos'] as const;
---

<section id="habilidades" class="py-16 md:py-20 border-t border-slate-800/80 max-w-6xl mx-auto px-4 sm:px-6">
  <div class="space-y-3 mb-10 text-center max-w-2xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-blue-500/10 border border-blue-500/20 text-blue-400">
      <span>🛠️ Stack Tecnológico</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
      Habilidades & Tecnologías
    </h2>
    <p class="text-slate-400 text-sm">
      Herramientas y lenguajes que utilizo activamente para construir interfaces frontend reactivas y software robusto.
    </p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    {categories.map((cat) => {
      const skillsInCat = personalInfo.skills.filter((s) => s.category === cat);
      return (
        <div class="rounded-2xl bg-gradient-to-b from-[#10192e] to-[#0c1220] border border-slate-800/80 p-5 space-y-4">
          <div class="flex items-center gap-2 pb-2 border-b border-slate-800">
            <span class="text-sm">
              {cat === 'Frontend' ? '🎨' : cat === 'Backend & Datos' ? '🗄️' : cat === 'Herramientas' ? '🔧' : '📐'}
            </span>
            <h3 class="font-semibold text-sm text-slate-200">{cat}</h3>
          </div>
          <ul class="space-y-2">
            {skillsInCat.map((skill) => (
              <li class="flex items-center gap-2 text-xs text-slate-300 bg-slate-900/50 px-3 py-2 rounded-lg border border-slate-800/60">
                <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
                <span>{skill.name}</span>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</section>
